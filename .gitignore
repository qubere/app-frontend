# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
#
# This is a monorepo (apps/*, packages/*): most patterns below are
# intentionally NOT root-anchored (no leading `/`) so they also match inside
# every workspace, not just the repo root.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage
test-results
playwright-report
blob-report
.playwright

# next.js
.next/
out/

# turborepo
.turbo/

# production
build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# clerk configuration (can include secrets)
.clerk/

# local document-processing artifacts (parsed customer document contents)
.qubere/

# public uploads directory (preserve .gitkeep only)
apps/custom/public/uploads/*
!apps/custom/public/uploads/.gitkeep

# turbo
.turbo

# clerk configuration (can include secrets)
/.clerk/

# database dumps
*.dump

