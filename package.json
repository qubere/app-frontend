{
  "name": "app-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "typecheck:workspaces": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "npm run test:e2e --workspace=apps/custom",
    "worker:documents": "npm run worker:documents --workspace=apps/custom",
    "openapi": "npm run openapi --workspace=apps/custom",
    "scheduler:generate": "tsx infrastructure/gcp/generate-configure-scheduler.mjs",
    "scheduler:check": "tsx infrastructure/gcp/generate-configure-scheduler.mjs --check",
    "product-help:generate": "npm --workspace @qubere/custom run generate:product-help --",
    "product-help:report": "npm --workspace @qubere/custom run generate:product-help:report --",
    "product-help:validate": "npm --workspace @qubere/custom run validate:product-help",
    "product-help:sync": "npm --workspace @qubere/custom run sync:product-help",
    "portal:diagnose": "node apps/portal/scripts/diagnose-setup.mjs",
    "seed": "npm run db:seed --workspace=packages/db"
  },
  "devDependencies": {
    "@types/node": "^20",
    "turbo": "^2.10.11",
    "typescript": "^5"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  }
}
