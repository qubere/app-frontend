{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "prisma/**/*.ts"],
  "exclude": [
    "node_modules",
    "prisma/seeds/**",
    "prisma/seed.ts",
    "prisma/seed-deadlines.ts",
    "prisma/seed-f06.ts",
    "prisma/import-hts.ts",
    "prisma/import-hts-local.ts"
  ]
}
