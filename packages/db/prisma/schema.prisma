/// Concurrency-safe allocator for per-account, per-year shipment numbers.
/// Replaces count()+1 numbering, which races under concurrent creates.
model ShipmentSequence {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  year      Int
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([accountId, year])
}

model User {
  assignedInboundAddresses InboundAddress[]    @relation("InboundAddressAssignee")
  clientStakeholders       ClientStakeholder[]
  id                       String              @id @default(cuid())
  clerkUserId              String              @unique
  email                    String              @unique
  firstName                String?
  lastName                 String?
  brokerLicenseNumber      String? // License number for licensed customs brokers
  deletedAt                DateTime?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  ownedAccounts                 Account[]                @relation("AccountOwner")
  createdInvitations            Invitation[]             @relation("InvitationCreator")
  platformRoles                 PlatformUserRole[]
  memberships                   AccountMembership[]
  auditLogs                     AuditLog[]
  reviewedDecisions             AgentDecision[]          @relation("DecisionReviewer")
  assignedShipments             Shipment[]               @relation("ShipmentBroker")
  createdTransportationOrders   TransportationOrder[]    @relation("OrderCreator")
  assignedExceptions            ExceptionItem[]          @relation("ExceptionAssignee")
  assignedFindings              ComplianceFinding[]      @relation("FindingAssignee")
  createdScenarios              LandedCostScenario[]     @relation("ScenarioCreator")
  createdPSCs                   PostSummaryCorrection[]  @relation("PSCCreator")
  shipmentChangeEvents          ShipmentChangeEvent[]
  assignedDocuments             ShipmentDocument[]       @relation("DocumentAssignee")
  uploadedDocuments             ShipmentDocument[]       @relation("DocumentUploader")
  assignedCustomsCases          CustomsCase[]            @relation("CustomsCaseBroker")
  inboundSenderRoutes           InboundSenderRoute[]     @relation("InboundRouteAssignee")
  notifications                 Notification[]
  clientAssignments             UserClientAssignment[]
  teamMemberships               AccountTeamMembership[]
  impersonationsStarted         ImpersonationSession[]   @relation("ImpersonationActor")
  impersonatedSessions          ImpersonationSession[]   @relation("ImpersonationEffective")
  auditLogsAsActor              AuditLog[]               @relation("AuditActor")
  auditLogsAsEffective          AuditLog[]               @relation("AuditEffective")
  initiatedComplianceExecutions ComplianceExecution[]
  publishedFilings              CustomsFiling[]          @relation("FilingPublisher")
  createdCustomerRequests       CustomerRequest[]        @relation("RequestCreator")
  closedCustomerRequests        CustomerRequest[]        @relation("RequestCloser")
  assignedCustomerRequests      CustomerRequest[]        @relation("RequestAssignee")
  authoredRequestMessages       CustomerRequestMessage[] @relation("MessageAuthor")
  assignedDecisions             AgentDecision[]          @relation("DecisionAssignee")

  @@index([clerkUserId])
  @@index([email])
  @@index([deletedAt])
}

model PlatformRole {
  id          String   @id @default(cuid())
  name        String   @unique // PLATFORM_ADMIN, CUSTOMER_SUPPORT, BILLING_ADMIN, SECURITY_ADMIN
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles PlatformUserRole[]
}

model PlatformUserRole {
  userId         String
  platformRoleId String
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  platformRole PlatformRole @relation(fields: [platformRoleId], references: [id], onDelete: Cascade)

  @@id([userId, platformRoleId])
}

model AccountMembership {
  id        String                  @id @default(cuid())
  accountId String
  account   Account                 @relation(fields: [accountId], references: [id], onDelete: Cascade)
  userId    String
  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles     AccountMembershipRole[]
  status    String                  @default("ACTIVE") // ACTIVE, INACTIVE, DISABLED
  deletedAt DateTime?
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  @@unique([accountId, userId])
  @@index([userId])
  @@index([accountId])
  @@index([deletedAt])
}

// A membership can hold multiple simultaneous roles on the same account
// (e.g. a broker who is both Admin and Agent), mirroring how PlatformUserRole
// already lets a user hold multiple platform roles at once.
model AccountMembershipRole {
  accountMembershipId String
  roleId              String
  createdAt           DateTime @default(now())

  accountMembership AccountMembership @relation(fields: [accountMembershipId], references: [id], onDelete: Cascade)
  role              Role              @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([accountMembershipId, roleId])
  @@index([roleId])
}

model Role {
  id          String   @id @default(cuid())
  accountId   String? // NULL for system default roles (OWNER, ADMIN, MEMBER, VIEWER), or specific account ID for custom roles
  account     Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name        String // OWNER, ADMIN, MEMBER, VIEWER, or Custom Role Name
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  membershipRoles AccountMembershipRole[]
  rolePermissions RolePermission[]
  invitations     Invitation[]

  @@unique([accountId, name])
  @@index([accountId])
  @@index([isSystem])
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique // account.manage, users.manage, documents.create, documents.read, etc.
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Invitation {
  id              String   @id @default(cuid())
  accountId       String
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  clientId        String?
  client          Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  purpose         String   @default("WORKBENCH") // WORKBENCH, CUSTOMER_PORTAL
  productScopes   String[] @default(["CUSTOMS"]) // CUSTOMS, TMS
  email           String
  token           String   @unique @default(cuid())
  roleId          String
  role            Role     @relation(fields: [roleId], references: [id])
  status          String   @default("PENDING") // PENDING, ACCEPTED, EXPIRED, REVOKED
  expiresAt       DateTime
  createdByUserId String?
  createdByUser   User?    @relation("InvitationCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([accountId])
  @@index([clientId])
  @@index([email])
  @@index([token])
  @@index([createdByUserId])
}

model AuditLog {
  id                     String                @id @default(cuid())
  accountId              String
  account                Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  userId                 String?
  user                   User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  actorUserId            String?
  actorUser              User?                 @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  effectiveUserId        String?
  effectiveUser          User?                 @relation("AuditEffective", fields: [effectiveUserId], references: [id], onDelete: SetNull)
  impersonationSessionId String?
  impersonationSession   ImpersonationSession? @relation(fields: [impersonationSessionId], references: [id], onDelete: SetNull)
  reason                 String?
  action                 String
  entity                 String
  entityId               String
  resourceType           String?
  resourceId             String?
  clientId               String?
  oldValue               Json?
  newValue               Json?
  source                 String                @default("UI")
  metadata               Json?
  ipAddress              String?
  userAgent              String?
  requestId              String?
  success                Boolean               @default(true)
  createdAt              DateTime              @default(now())

  @@index([accountId])
  @@index([userId])
  @@index([actorUserId])
  @@index([effectiveUserId])
  @@index([impersonationSessionId])
  @@index([source])
  @@index([success])
}

model IdempotencyRecord {
  id             String   @id @default(cuid())
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  idempotencyKey String
  requestHash    String
  statusCode     Int
  responseBody   Json
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@unique([accountId, idempotencyKey])
  @@index([accountId])
  @@index([expiresAt])
}

// -----------------------------------------------------------------------------
// CORE ENTERPRISE TRADE COMPLIANCE DOMAIN MODELS
// -----------------------------------------------------------------------------

model Shipment {
  entryProofs EntryProof[]
  pgaHolds PgaHold[]

  id                 String                 @id @default(cuid())
  accountId          String
  account            Account                @relation(fields: [accountId], references: [id], onDelete: Cascade)
  shipmentNumber     String // e.g. SHP-2026-004872
  importerName       String // e.g. ABC Manufacturing India Pvt Ltd
  importerOfRecordId String?
  importerOfRecord   ImporterOfRecord?      @relation(fields: [importerOfRecordId], references: [id], onDelete: SetNull)
  clientId           String?
  client             Client?                @relation(fields: [clientId], references: [id], onDelete: SetNull)
  assignedBrokerId   String?
  assignedBroker     User?                  @relation("ShipmentBroker", fields: [assignedBrokerId], references: [id], onDelete: SetNull)
  poReference        String? // e.g. PO-778899
  entryType          String?
  incoterm           String?
  portOfEntry        String?
  carrierName        String?
  countryOfExport    String?
  countryOfOrigin    String?
  // ISO 4217 currency the commercial invoice/line items are denominated in.
  // Defaults to USD; set from document extraction when a non-USD invoice is
  // detected. Duty/valuation computation converts to USD via ExchangeRate
  // before any customs-value math -- see resolveExchangeRate().
  invoiceCurrency    String?                @default("USD")
  // ISO 3166-1 alpha-2 country this shipment is being imported INTO, distinct
  // from countryOfExport/countryOfOrigin above. Human-entered at creation --
  // this is what the shipment's canonical filing declaration is filed against,
  // and what selects the third-party procedure/message-catalog mapping. Never
  // inferred, because a wrong destination silently misfiles an entry.
  destinationCountry String?
  estimatedArrival   DateTime?
  ladingDate         DateTime? // On-board / ETD â€” ISF anchor; set from BL extraction or broker override
  arrivalDate        DateTime? // Actual arrival at first US port; falls back to estimatedArrival
  transportMode      String? // Ocean | Air | Truck | Rail â€” ISF applies to Ocean only
  filingDeadline     DateTime? // Derived cache: min(dueAt) over OPEN blocking ComplianceDeadlines
  status             String                 @default("Draft") // Draft, In Progress, Ready to File, On Hold, Submitted, Completed, DELIVERED, Delivered with Exception (the latter two are written by apps/tms's POD pipeline)
  customsRequired    Boolean                @default(false)
  // Workflow lifecycle stage. Values: DOCUMENT_INTAKE | CLASSIFICATION | VALUATION | ORIGIN | COMPLIANCE | FILING_PREP | READY_TO_FILE
  currentStage       String?
  stageStatus        String? // IN_PROGRESS | GATE_PENDING | BLOCKED | COMPLETE
  stageEnteredAt     DateTime?
  stageUpdatedAt     DateTime?
  autoAdvance        Boolean                @default(true) // per-shipment kill switch
  stageHistory       ShipmentStageHistory[]
  stageRuns          PipelineStageRun[]

  healthStatus   String? // Healthy, At Risk, Critical â€” derived, null until evaluated
  readinessScore Int? // 0 - 100 percentage, null until calculated
  riskScore      Int? // 0 - 100 risk score, null until calculated
  ownerName      String?
  version        Int       @default(1)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // -------------------------------------------------------------------------
  // TMS OPERATIONAL FIELDS
  // Added for agentic TMS: customer promise, LFD, and derived financial cache.
