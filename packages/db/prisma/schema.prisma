datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  // The Postgres host provides pgvector; declaring it here lets `prisma migrate`
  // track that the extension is expected without Prisma trying to manage the
  // vector column itself (that stays Unsupported -- see AccountMemory).
  extensions = [vector]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

/// Controls whether a workspace holds real operational data or clearly-labelled
/// demonstration data. Demo/sandbox content must never appear in a PRODUCTION
/// workspace.
enum DataMode {
  PRODUCTION
  DEMO
  SANDBOX
}

/// Canonical document type codes understood by the classification pipeline.
/// OTHER is the explicit fallback; NEEDS_CLASSIFICATION is signalled via
/// ShipmentDocument.status, not via this enum.
enum DocumentType {
  COMMERCIAL_INVOICE
  PACKING_LIST
  BILL_OF_LADING
  AIR_WAYBILL
  CERTIFICATE_OF_ORIGIN
  PHYTOSANITARY_CERTIFICATE
  FUMIGATION_CERTIFICATE
  CUSTOMS_BOND
  POWER_OF_ATTORNEY
  ENTRY_SUMMARY
  ISF
  PROOF_OF_DELIVERY
  CARRIER_INVOICE
  OTHER
}

/// Business entity types a document can be linked to via DocumentAssociation.
/// Kept intentionally small -- add a value only once real route/RBAC support
/// exists for that entity type.
enum DocumentEntityType {
  SHIPMENT
  PARTY
  PRODUCT
  LICENSE
  FILING
}

/// Semantics of a document-to-entity link. GENERAL is the safe default when
/// no more specific relationship is known.
enum DocumentRelationshipType {
  SOURCE_DOCUMENT
  SUPPORTING_DOCUMENT
  FILING_ATTACHMENT
  LICENSE_EVIDENCE
  ORIGIN_EVIDENCE
  GENERAL
}

/// Normalized ingestion channel for a document -- the surface it arrived
/// through. Distinct from the legacy free-text `ShipmentDocument.source`,
/// which is retained for back-compat. Used for display, audit, and analytics,
/// never for authorization.
enum DocumentChannel {
  WEB_APP // broker signed in to the main app UI
  CUSTOMER_PORTAL // customer signed in to the partner portal
  EMAIL // inbound email attachment (portal endpoint or per-request upload link)
  API // /v1/intake ingest endpoint (machine caller)
  INTEGRATION // pulled from a connected system (QuickBooks, TMS, ...)
  SYSTEM // generated by Qubere itself (e.g. rendered PDFs, migrations)
}

/// What kind of actor uploaded a document. Broker staff and portal customers
/// are different populations even though both are `User` rows.
enum DocumentUploaderType {
  INTERNAL_USER // Qubere / broker staff
  CUSTOMER_USER // partner-portal customer user
  API_CLIENT // authenticated machine caller
  EMAIL_SENDER // no logged-in user; attributed to the sending address
  SYSTEM // Qubere itself
}

/// How a DocumentAssociation came to exist -- used for display and audit, not
/// for authorization (authorization always derives from the authenticated
/// account context, never from this field).
enum DocumentAssociationSource {
  USER
  DOCUMENT_INTELLIGENCE
  INTEGRATION
  SYSTEM
  MIGRATION
}

// Normalized shipment-tracking vocabulary. Provider payloads are retained
// separately; these enums are the stable contract consumed by Qubere's UI,
// rules, and APIs.
enum TrackingIdentifierType {
  MBL
  HBL
  BOOKING
  CONTAINER
  MAWB
  HAWB
  PRO
  TRACKING
}

enum TrackingTransportMode {
  OCEAN
  AIR
  RAIL
  TRUCK
  PARCEL
}

enum TrackingEventClassifier {
  PLANNED
  ESTIMATED
  ACTUAL
}

enum TrackingSourceType {
  PROVIDER
  CARRIER
  TERMINAL
  PORT
  AIS
  USER
  SYSTEM
  CBP
  DOCUMENT
}

enum TrackingSubscriptionStatus {
  PENDING
  ACTIVE
  PAUSED
  FAILED
  ENDED
}

enum LegMode {
  OCEAN
  AIR
  RAIL
  TRUCK
  BARGE
  COURIER
}

enum LegType {
  EXPORT_HAULAGE
  MAIN_CARRIAGE
  TRANSSHIPMENT
  IMPORT_HAULAGE
  ON_CARRIAGE
}

enum LegStatus {
  PLANNED
  BOOKED
  READY_FOR_PICKUP
  IN_TRANSIT
  ARRIVED
  COMPLETED
  EXCEPTION
  CANCELLED
}

enum LegDocumentRequirement {
  REQUIRED
  CONDITIONAL
  OPTIONAL
  INFO_ONLY
}

// ---------------------------------------------------------------------------
// COMPLIANCE DEADLINE ENUMS
// ---------------------------------------------------------------------------

enum DeadlineType {
  ISF_10_2 // 24h before lading, ocean only
  ENTRY_FILING // 15 calendar days after arrival
  ENTRY_SUMMARY // 10 working days after release
  DUTY_PAYMENT // with summary, or PMS 15th working day following month
  PMS_STATEMENT // reserved â€” no trustworthy anchor yet
  LAST_FREE_DAY // carrier-set; deadlineClass = COMMERCIAL
  PSC_WINDOW // reserved â€” no ACE/ABI feed
  LIQUIDATION // reserved â€” no ACE/ABI feed
  PROTEST_WINDOW // 180 calendar days from liquidation date
  CIT_APPEAL_WINDOW // 180 days from CBP denial or deemed-denial
  DEEMED_DENIAL // protest filed + 2 years
  CF28_RESPONSE // reserved â€” no CBP notice ingestion
  CF29_RESPONSE // reserved â€” no CBP notice ingestion
}

enum DeadlineAnchor {
  LADING // vessel on-board date / ETD
  ARRIVAL // actual or estimated arrival at first US port
  RELEASE // CBP release / 7501 stamped date
  ENTRY // entry acceptance date
  LIQUIDATION // liquidation date
  CBP_NOTICE // date CBP notice was issued (CF28/CF29)
  CARRIER_TERMS // carrier-published free-time rule (Last Free Day)
}

enum DeadlineStatus {
  OPEN
  SATISFIED
  MISSED
  WAIVED
  NOT_APPLICABLE
}

enum DeadlineClass {
  REGULATORY // statutory â€” CBP rules, CFR citations apply
  COMMERCIAL // carrier / port terms (e.g. Last Free Day)
}

