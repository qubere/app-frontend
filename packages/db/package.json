{
  "name": "@qubere/db",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./dataMode": "./src/dataMode.ts",
    "./environment": "./src/environment.ts",
    "./services/shared-upload-service": "./src/services/shared-upload-service.ts",
    "./services/document-provenance": "./src/services/document-provenance.ts",
    "./services/client-setup-service": "./src/services/client-setup-service.ts",
    "./services/onboarding-readiness": "./src/services/onboarding-readiness.ts",
    "./services/inbound-address-service": "./src/services/inbound-address-service.ts"
  },
  "scripts": {
    "build": "prisma generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:diff": "prisma migrate diff --from-migrations prisma/migrations --to-schema-datamodel prisma/schema.prisma",
    "db:check-migration-timestamps": "node scripts/check-migration-timestamps.mjs",
    "db:seed": "npx tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@qubere/storage": "*"
  },
  "devDependencies": {
    "prisma": "^6.19.3",
    "tsx": "^4.23.5",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
