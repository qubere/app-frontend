# Client-specific inbound email rollout. Set on both Custom and Portal services.
# These supplement the existing database, authentication, and storage settings.
INBOUND_CLIENT_ADDRESSES_ENABLED=false
INBOUND_EMAIL_DOMAIN=inbound.qubere.ai
INBOUND_ADDRESS_TOKEN_BYTES=10
INBOUND_AUTO_ATTACH_THRESHOLD=0.75

# Enable only after observing a sandbox receipt; per-address opt-out also applies.
INBOUND_AUTO_REPLY_ENABLED=false
# Existing provider secrets must be supplied by the deployment secret manager.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_FROM_ADDRESS=
# Legacy routing only, while INBOUND_CLIENT_ADDRESSES_ENABLED=false.
RESEND_ALLOWED_INBOUND_RECIPIENTS=docs@inbound.qubere.ai

# Configure a real scanner before accepting inbound attachments.
# Client-address intake requires a CLEAN result regardless of manual-upload policy.
DOCUMENT_MALWARE_SCAN_MODE=block
CLAMAV_HTTP_URL=
# Alternative to HTTP: CLAMAV_HOST and CLAMAV_PORT (default 3310).
